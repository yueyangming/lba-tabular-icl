# Primary Qwen experiments (DashScope/OpenAI-compatible endpoint)
QWEN_PROVIDER=aliyun
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_DEFAULT_MODEL=qwen3.5-35b-a3b
DASHSCOPE_LATEST_MODEL=qwen3.5-397b-a17b
DASHSCOPE_DEBUG_MODEL=qwen3.5-27b

# Cross-family experiment (optional)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_LATEST_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_DEBUG_MODEL=meta-llama/llama-3.3-70b-instruct

# Optional request metadata for OpenRouter
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=LBA Tabular ICL
